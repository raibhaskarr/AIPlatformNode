{
  "name": "aiplatformnode",
  "version": "0.1.0-preview.1",
  "private": true,
  "engines": {
    "node": ">=22.3.0 <23"
  },
  "workspaces": [
    "packages/*",
    "packages/providers/*",
    "samples/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -b tsconfig.json",
    "pretest": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "presample": "npm run build",
    "sample": "tsx samples/basic-sample/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
